<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1752085127925-1" author="wences">
        <createTable tableName="driver_profile">
            <column name="user_id" type="VARCHAR(255)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_driverprofile"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1752085127925-2" author="wences">
        <createTable tableName="passenger_profile">
            <column name="user_id" type="VARCHAR(255)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_passengerprofile"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1752085127925-3" author="wences">
        <createTable tableName="user">
            <column name="id" type="VARCHAR(255)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user"/>
            </column>
            <column name="email" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="1752085127925-4" author="wences">
        <addForeignKeyConstraint baseColumnNames="user_id" baseTableName="driver_profile"
                                 constraintName="FK_DRIVERPROFILE_ON_USER" referencedColumnNames="id"
                                 referencedTableName="user"/>
    </changeSet>
    <changeSet id="1752085127925-5" author="wences">
        <addForeignKeyConstraint baseColumnNames="user_id" baseTableName="passenger_profile"
                                 constraintName="FK_PASSENGERPROFILE_ON_USER" referencedColumnNames="id"
                                 referencedTableName="user"/>
    </changeSet>

</databaseChangeLog>